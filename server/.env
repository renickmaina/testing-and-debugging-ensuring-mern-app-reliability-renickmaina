# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/bugtracker
# Alternative: MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bugtracker?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=supersecretkey

# Optional: Enhanced Security (if you add these features later)
# BCRYPT_SALT_ROUNDS=12
# CORS_ORIGIN=http://localhost:3000

# Optional: Email Service (for notifications)
# EMAIL_SERVICE=gmail
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@bugtracker.com

# Optional: File Upload (if you add file attachments)
# UPLOAD_PATH=./uploads
# MAX_FILE_SIZE=5242880

# Optional: Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100